+
+// --- Scenario B: clear wave 2 -> wave 3 (boss) ---
+st.invaders.forEach((iv) => { iv.alive = false; });
+if (!frames(3)) {
+  console.log("FAIL B: " + err.message + "\n" + err.stack.split("\n").slice(0, 3).join("\n"));
